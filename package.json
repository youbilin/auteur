{
  "name": "auteur",
  "version": "0.2.0",
  "private": true,
  "description": "Model-agnostic motion graphics studio: brief to deterministic video with a critic loop and a local Studio.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "bin": {
    "auteur": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "node --import tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prompts.mjs",
    "doctor": "node --import tsx src/cli/index.ts doctor",
    "plan": "node --import tsx src/cli/index.ts plan",
    "render": "node --import tsx src/cli/index.ts render",
    "qa": "node --import tsx src/cli/index.ts qa",
    "fix": "node --import tsx src/cli/index.ts fix",
    "make": "node --import tsx src/cli/index.ts make",
    "preview": "node --import tsx src/cli/index.ts preview",
    "studio": "concurrently -k \"node --import tsx studio/server.ts\" \"vite --config studio/vite.config.ts\"",
    "studio:api": "node --import tsx studio/server.ts",
    "studio:build": "vite build --config studio/vite.config.ts",
    "studio:serve": "node --import tsx studio/server.ts",
    "e2e": "node --import tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "commander": "^15.0.0",
    "fast-json-patch": "^3.1.1",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.181",
    "lucide-react": "^1.60.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
