{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Auteur Studio",
  "version": "0.2.0",
  "identifier": "com.youbilin.auteur",
  "build": {
    "frontendDist": "launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auteur Studio",
        "width": 1180,
        "height": 640,
        "minWidth": 1120,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
